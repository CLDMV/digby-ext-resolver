{
	"name": "@cldmv/digby-ext-resolver",
	"version": "0.0.1",
	"description": "Resolver — built on @cldmv/rummage.",
	"type": "module",
	"license": "Apache-2.0",
	"author": { "name": "Shinrai", "company": "CLDMV", "email": "git+npm@cldmv.net", "url": "https://cldmv.net" },
	"contributors": [{ "name": "CLDMV", "url": "https://github.com/CLDMV" }],
	"funding": { "type": "github", "url": "https://github.com/sponsors/shinrai" },
	"publishConfig": { "access": "public" },
	"sideEffects": false,
	"engines": { "node": ">=24.15.0" },
	"devEngines": { "runtime": { "name": "node", "version": ">=24.15.0", "onFail": "error" } },
