		"./view": "./src/view/resolver/resolver.mjs",
		"./package.json": "./package.json"
	},
	"files": ["src/", "sql/", "docs/", "rummage.manifest.mjs", "LICENSE", "README.md"],
	"scripts": {
		"test": "node tests/run-vitest.mjs",
